{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.warpmetal.com/registry.schema.json",
  "title": "WarpMetal Skills Registry",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "skills"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["name", "version", "description", "path", "files"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "roles": { "type": "array", "items": { "type": "string" } },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "minimumWarpmetalCli": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
