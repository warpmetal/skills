{
  "name": "@warpmetal/skills-mcp",
  "version": "0.2.0",
  "description": "MCP server for WarpMetal Agent Skills discovery plus the WarpMetal CLI surface: 3 skill_* content tools everywhere and 43 wm_* CLI tools over stdio, with a hardened gate for the irreversible ones (named consequence, TOCTOU re-verification, a persistent manual_review latch), a CLI version floor and a concurrency ceiling.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "warpmetal-skills-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "snapshot/",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warpmetal/skills.git"
  },
  "homepage": "https://github.com/warpmetal/skills#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:contract": "node --import tsx --test test/contract.test.ts",
    "test:live": "node --import tsx --test test/live.test.ts",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "warpmetal": "0.8.12"
  }
}
