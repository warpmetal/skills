              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "systemInstruction": {
            "additionalProperties": true,
            "description": "Developer-set system instruction, as a Content object.",
            "properties": {},
            "type": "object"
          },
          "toolConfig": {
            "additionalProperties": true,
            "description": "Configuration for the declared tools.",
            "properties": {},
            "type": "object"
          },
          "tools": {
            "description": "Tool declarations the model may call.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          }
