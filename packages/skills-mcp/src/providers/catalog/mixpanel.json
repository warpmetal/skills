          },
          "limit": {
            "description": "Maximum events to return.",
            "type": "integer"
          },
          "project_id": {
            "description": "Mixpanel project id (for example 12345).",
            "type": "integer"
          },
          "to_date": {
            "description": "Inclusive end date yyyy-mm-dd.",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "from_date",
          "to_date"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "annotations": {
