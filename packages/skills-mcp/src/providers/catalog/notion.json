          "created_time": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_edited_time": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "annotations": {
        "title": "Retrieve Notion Page",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true,
        "destructiveHint": false
      }
    },
    {
      "toolSlug": "notion_create_page",
      "name": "create_page",
      "title": "Create Notion Page",
