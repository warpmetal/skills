          "title"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "annotations": {
        "title": "Create Notion Page",
        "readOnlyHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "destructiveHint": true
      }
    },
