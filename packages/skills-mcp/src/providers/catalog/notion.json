    {
      "toolSlug": "notion_search",
      "name": "search",
      "title": "Search Notion",
      "description": "Search pages and databases the Notion connection can access.",
      "toolkitId": "notion",
      "version": "v1",
      "inputSchema": {
        "properties": {
          "page_size": {
            "description": "Max results to return (Notion caps at 100).",
            "type": "integer"
          },
          "query": {
            "description": "Text to search titles for. Omit to list everything shared with the integration.",
            "type": "string"
          },
          "start_cursor": {
            "description": "Pagination cursor from a previous response's next_cursor.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "annotations": {
        "title": "Search Notion",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "toolSlug": "notion_query_database",
      "name": "query_database",
      "title": "Query Notion Database",
      "description": "Query the entries of a classic Notion database with optional filters and sorts. Use it only when the workspace still exposes a legacy database; query_data_source is the modern replacement and should be preferred.",
      "toolkitId": "notion",
      "version": "v6",
      "inputSchema": {
        "properties": {
          "database_id": {
            "description": "Database ID.",
            "type": "string"
          },
          "filter": {
            "description": "Notion filter object (passthrough).",
            "type": "object"
          },
          "page_size": {
            "type": "integer"
          },
          "sorts": {
            "description": "Notion sorts array (passthrough).",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "start_cursor": {
            "type": "string"
          }
        },
        "required": [
          "database_id"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "annotations": {
        "title": "Query Notion Database",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true,
        "destructiveHint": false
      }
    },
    {
      "toolSlug": "notion_get_page",
      "name": "get_page",
      "title": "Retrieve Notion Page",
      "description": "Retrieve a Notion page by ID.",
      "toolkitId": "notion",
      "version": "v2",
      "inputSchema": {
        "properties": {
          "page_id": {
            "description": "Page ID.",
            "type": "string"
          }
        },
        "required": [
