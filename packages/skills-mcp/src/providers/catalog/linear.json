    {
      "toolSlug": "linear_create_comment",
      "name": "create_comment",
      "title": "Create Linear Comment",
      "description": "Create a comment on a Linear issue by id or identifier.",
      "toolkitId": "linear",
      "version": "v2",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "description": "Comment content in markdown. Maps to CommentCreateInput.body.",
            "minLength": 1,
            "type": "string"
          },
          "body_data": {
            "description": "[Internal] Comment content as a Prosemirror document. Maps to CommentCreateInput.bodyData."
          },
          "create_as_user": {
            "description": "Create as a user with this name (OAuth actor=app only). Maps to CommentCreateInput.createAsUser.",
            "minLength": 1,
            "type": "string"
          },
          "create_on_synced_slack_thread": {
            "description": "Create on the issue's synced Slack thread (fails if none). Maps to CommentCreateInput.createOnSyncedSlackThread.",
            "type": "boolean"
          },
          "created_at": {
            "description": "Past creation timestamp for imports (ISO-8601). Maps to CommentCreateInput.createdAt.",
            "minLength": 1,
            "type": "string"
          },
          "display_icon_url": {
            "description": "External avatar URL; requires create_as_user (OAuth actor=app only). Maps to CommentCreateInput.displayIconUrl.",
            "minLength": 1,
            "type": "string"
          },
          "do_not_subscribe_to_issue": {
            "description": "If true, do not auto-subscribe to the issue. Maps to CommentCreateInput.doNotSubscribeToIssue.",
            "type": "boolean"
          },
          "document_content_id": {
            "description": "Document content to associate the comment with. Maps to CommentCreateInput.documentContentId.",
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "description": "Optional comment UUID v4. If omitted, Linear generates one. Maps to CommentCreateInput.id.",
            "minLength": 1,
            "type": "string"
          },
          "initiative_id": {
            "description": "Initiative to associate the comment with. Maps to CommentCreateInput.initiativeId.",
            "minLength": 1,
            "type": "string"
          },
          "initiative_update_id": {
            "description": "Initiative update to associate the comment with. Maps to CommentCreateInput.initiativeUpdateId.",
            "minLength": 1,
            "type": "string"
          },
          "issue_id": {
            "description": "Issue UUID or identifier (e.g. DIG-7) to associate the comment with. Maps to CommentCreateInput.issueId.",
            "minLength": 1,
            "type": "string"
          },
          "parent_id": {
            "description": "Parent comment id to nest under. Maps to CommentCreateInput.parentId.",
            "minLength": 1,
            "type": "string"
          },
          "post_id": {
            "description": "Post to associate the comment with. Maps to CommentCreateInput.postId.",
            "minLength": 1,
            "type": "string"
          },
          "project_id": {
            "description": "Project to associate the comment with. Maps to CommentCreateInput.projectId.",
            "minLength": 1,
            "type": "string"
          },
          "project_update_id": {
            "description": "Project update to associate the comment with. Maps to CommentCreateInput.projectUpdateId.",
            "minLength": 1,
            "type": "string"
          },
          "quoted_text": {
            "description": "Referenced text for inline comments. Maps to CommentCreateInput.quotedText.",
            "type": "string"
          },
          "subscriber_ids": {
            "description": "[Internal] User ids subscribing to this comment thread. Maps to CommentCreateInput.subscriberIds.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "body",
          "issue_id"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "comment": {
            "properties": {
              "body": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "annotations": {
        "title": "Create Linear Comment",
        "readOnlyHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "destructiveHint": false
      }
    }
