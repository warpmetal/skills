{
  "name": "@warpmetal/cli",
  "version": "0.1.0",
  "description": "The warpmetal CLI: the env credential store and the integration layer, plus verbatim delegation of the VPS lifecycle to the published upstream CLI.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "warpmetal": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist/",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warpmetal/skills.git"
  },
  "homepage": "https://github.com/warpmetal/skills#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "probe": "node --import tsx scripts/probe-mcp-routes.mjs",
    "probe:record": "node --import tsx scripts/probe-mcp-routes.mjs --record test/fixtures/probe-verdicts.json",
    "probe:plane": "node --import tsx scripts/plane/probe.mjs",
    "gen:cloudflare-inventory": "node --import tsx scripts/gen-cloudflare-inventory.mjs",
    "gen:cloudflare-routes": "node --import tsx scripts/gen-cloudflare-routes.mjs",
    "gen:cloudflare-params": "node --import tsx scripts/gen-cloudflare-params.mjs",
    "gen:mcp-tools": "node --import tsx scripts/gen-mcp-tools.mjs",
    "check:mcp-tools": "node --import tsx scripts/gen-mcp-tools.mjs --check",
    "gen:mcp-fixtures": "node --import tsx scripts/gen-mcp-contract-fixtures.mjs",
    "check:mcp-fixtures": "node --import tsx scripts/gen-mcp-contract-fixtures.mjs --check",
    "gen:plane-inventory": "node scripts/plane/fetch-inventory.mjs --update",
    "check:plane-inventory": "node scripts/plane/fetch-inventory.mjs --check",
    "gen:plane-sdk": "node scripts/plane/fetch-sdk.mjs --update",
    "check:plane-sdk": "node scripts/plane/fetch-sdk.mjs --check",
    "gen:plane-routes": "node --import tsx scripts/gen-plane-routes.mjs",
    "check:plane-routes": "node --import tsx scripts/gen-plane-routes.mjs --check",
    "check:plane-allowlist": "node --import tsx scripts/plane/check.mjs",
    "gen:plane-docs": "node --import tsx scripts/gen-plane-docs.mjs",
    "check:plane-docs": "node --import tsx scripts/gen-plane-docs.mjs --check",
    "check:plane": "npm run check:plane-inventory && npm run check:plane-sdk && npm run check:plane-allowlist && npm run check:plane-routes && npm run check:plane-docs",
    "check:plane-offline": "npm run check:plane-allowlist && npm run check:plane-routes && npm run check:plane-docs && npm run check:mcp-tools && npm run check:mcp-fixtures",
    "probe:grafana-stack": "node --import tsx --test test/grafana-stack-probe.test.ts",
    "e2e:grafana-stack": "node --import tsx --test test/grafana-stack-e2e.test.ts",
    "gen:grafana-stack-params": "node --import tsx scripts/gen-grafana-stack-params.mjs",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "warpmetal-upstream": "npm:warpmetal@0.8.12"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
