{
  "method": "POST",
  "url": "https://api.cloudflare.com/client/v4/accounts/sample_account_id/access/service_tokens",
  "body": {
    "client_secret_version": 1,
    "duration": "sample_duration",
    "enabled": true,
    "name": "sample_name",
    "previous_client_secret_expires_at": "sample_previous_client_secret_expires_at"
  },
  "headers": {
    "Authorization": "Bearer __TOKEN__",
    "Content-Type": "application/json"
  }
}
