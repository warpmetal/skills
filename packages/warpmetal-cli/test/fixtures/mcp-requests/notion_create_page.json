{
  "method": "POST",
  "url": "https://api.notion.com/v1/pages",
  "body": {
    "parent": {
      "page_id": "sample_parent_page_id"
    },
    "properties": {
      "title": {
        "title": [
          {
            "type": "text",
            "text": {
              "content": "sample_title"
            }
          }
        ]
      }
    },
    "children": [
      {
        "object": "block",
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "sample_content"
              }
            }
          ]
        }
      }
    ]
  },
  "headers": {
    "Authorization": "Bearer __TOKEN__",
    "Notion-Version": "2022-06-28",
    "Content-Type": "application/json"
  }
}
