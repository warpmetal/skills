{
  "method": "PATCH",
  "url": "https://api.cloudflare.com/client/v4/zones/sample_zone_id/observability/tracing/settings",
  "body": {
    "destinations": [],
    "enabled": true,
    "forward_context": true,
    "persist": true,
    "propagation_policy": "accept",
    "sampling_ratio": 1
  },
  "headers": {
    "Authorization": "Bearer __TOKEN__",
    "Content-Type": "application/json"
  }
}
