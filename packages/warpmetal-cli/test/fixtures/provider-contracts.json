  "tools": {
    "mixpanel_track_event": {
      "auth": null,
      "note": "POST /track is public (`security: []` in the ingestion OpenAPI): the project token travels inside each event's properties.token, and the body is a base64-JSON `data` form field, not a JSON body. Sending a JSON body answers HTTP 200 with status 0 (\"data, missing or empty\"), which is why the tool carries no auth header."
    },
    "mixpanel_raw_event_export": {
      "note": "GET /api/2.0/export/ enforces Basic auth with a service-account user and secret; the probe answers 401 without a credential, so the exact encoding is unconfirmed until one is available."
    },
    "posthog_get_feature_flags_matching_ids": {
      "note": "The matching-ids operation is GET /api/projects/{project_id}/feature_flags/matching_ids/ (a distinct path from the feature_flags list endpoint)."
    },
    "grafana-cloud_get_org": {
      "note": "A single organization is GET /api/orgs/{slugOrId} (path parameter). /api/orgs?orgSlug= is the legacy Grafana-server search endpoint, not this API."
    },
    "shopify_list_products": { "note": "Shopify ships a dated API version in the URL; it must be a currently supported stable version." },
    "shopify_get_product": { "note": "Shopify ships a dated API version in the URL; it must be a currently supported stable version." },
    "shopify_list_orders": { "note": "Shopify ships a dated API version in the URL; it must be a currently supported stable version." },
    "mailchimp_add_member_to_list": {
      "note": "skip_merge_validation is a query parameter and list_id is the path parameter; neither is a body field beyond Mailchimp's optional echo of list_id."
    },
    "confluence_get_page_by_id": {
      "note": "The draft selector on GET /wiki/api/v2/pages/{id} is the get-draft query parameter."
    },
    "snowflake_list_databases": {
      "note": "SHOW DATABASES clause order is [HISTORY] [LIKE] [STARTS WITH] [LIMIT [FROM]]."
    },
    "x_create_posts": {
      "experimental": true,
      "note": "X rejects app-only bearer tokens on the write endpoint; publishing needs an OAuth 2.0 user token, which this server does not collect yet."
    }
  }
